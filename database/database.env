# =====================================================
# Variables de Entorno - Base de Datos SistemaPasantias
# =====================================================

# Configuración MySQL
MYSQL_ROOT_PASSWORD=TuPasswordRoot123!
MYSQL_DATABASE=pasantias_db
MYSQL_USER=appuser
MYSQL_PASSWORD=TuPasswordSeguro123!

# Configuración Backend
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Connection String para Backend
ConnectionStrings__DefaultConnection=Server=mysql;Database=pasantias_db;User=appuser;Password=TuPasswordSeguro123!;Port=3306;CharSet=utf8mb4;

# Configuración de Red
MYSQL_PORT=3306
BACKEND_PORT=5000
REDIS_PORT=6379

# Configuración de Volúmenes
MYSQL_DATA_VOLUME=mysql_data
BACKUP_DIR=./backups
LOG_DIR=./logs

# Configuración de Seguridad
MYSQL_BIND_ADDRESS=0.0.0.0
MYSQL_MAX_CONNECTIONS=200
MYSQL_INNODB_BUFFER_POOL_SIZE=512M